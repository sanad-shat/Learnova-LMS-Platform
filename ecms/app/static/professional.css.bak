
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
:root{--navy:#071a36;--navy2:#0d2447;--primary:#5b46f5;--primary2:#2869ee;--cyan:#26b7e8;--green:#10b981;--amber:#f5aa13;--danger:#e73550;--bg:#f4f7fc;--card:#fff;--text:#0b1b3a;--muted:#6b7890;--line:#e4e9f2;--shadow:0 12px 35px rgba(8,27,58,.08);--radius:16px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,"Segoe UI",sans-serif;background:var(--bg);color:var(--text);line-height:1.5}a{text-decoration:none;color:inherit}button,input,select,textarea{font:inherit}button{cursor:pointer}.muted{color:var(--muted)}
.app-layout{display:grid;grid-template-columns:242px minmax(0,1fr);min-height:100vh}.sidebar{position:fixed;inset:0 auto 0 0;width:242px;background:linear-gradient(180deg,#071a36,#06162d);color:#dbe5f7;padding:22px 14px;z-index:80;overflow-y:auto;box-shadow:8px 0 28px rgba(3,13,29,.12)}.sidebar-brand{display:flex;align-items:center;gap:12px;padding:0 8px 24px;border-bottom:1px solid rgba(255,255,255,.09)}.sidebar-brand img{width:46px;height:46px}.brand-copy strong{display:block;color:#fff;font-size:18px;letter-spacing:-.3px}.brand-copy b{color:#8b7aff}.brand-copy small{display:block;color:#9aabc7;font-size:10px;letter-spacing:.06em}.nav-section{margin:22px 8px 9px;color:#6f84a5;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.side-nav{display:grid;gap:4px}.side-nav a{display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:9px;color:#d7e0ef;font-size:13px;font-weight:600;transition:.18s}.side-nav a:hover,.side-nav a.active{background:linear-gradient(100deg,#5d43f3,#4932dc);color:#fff;box-shadow:0 8px 18px rgba(83,62,235,.3)}.side-nav i{width:18px;text-align:center}.nav-badge{margin-left:auto;background:#673cff;color:white;border-radius:99px;padding:2px 7px;font-size:10px}.sidebar-footer{margin-top:26px}.help-link{display:flex;align-items:center;justify-content:center;gap:8px;background:linear-gradient(90deg,#5d43f3,#5e51e5);padding:11px;border-radius:9px;color:#fff;font-size:13px;font-weight:700}
.app-main{grid-column:2;min-width:0}.top-header{height:66px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px;position:sticky;top:0;z-index:60}.header-left,.header-right{display:flex;align-items:center;gap:15px}.menu-toggle{border:0;background:transparent;font-size:19px;color:#26354e}.search-box{position:relative;width:min(350px,35vw)}.search-box i{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#8793a8}.search-box input{width:100%;height:38px;border:1px solid #e2e7f0;background:#f7f9fc;border-radius:8px;padding:0 14px 0 38px}.header-icon{width:38px;height:38px;border:0;background:#f3f6fb;border-radius:10px;color:#384761;position:relative}.header-icon span{position:absolute;right:-2px;top:-3px;background:#6245ed;color:#fff;border-radius:99px;min-width:16px;height:16px;font-size:9px;display:grid;place-items:center}.profile-chip{display:flex;align-items:center;gap:10px}.profile-avatar{width:37px;height:37px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#6d55f5,#2c7af0);color:white;font-weight:800}.profile-chip strong{font-size:13px;display:block}.profile-chip small{font-size:10px;color:var(--muted)}
.content{padding:24px 28px 40px;max-width:1480px;margin:auto}.page-title-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px;gap:18px}.page-title-row h1{font-size:25px;line-height:1.2;margin:0 0 5px}.page-title-row p{margin:0;color:var(--muted);font-size:12px}.date-chip{border:1px solid var(--line);background:#fff;padding:9px 13px;border-radius:9px;color:#35445d;font-size:12px;font-weight:600}.flash{padding:12px 14px;border-radius:10px;margin-bottom:15px;font-weight:650;font-size:13px}.flash.success{background:#e9fbf4;color:#087b55}.flash.danger{background:#fff0f2;color:#b3243b}.flash.warning{background:#fff8df;color:#8d6500}.flash.info{background:#eaf6ff;color:#176b9b}
.stats-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:16px}.metric-card{background:#fff;border:1px solid var(--line);border-radius:13px;padding:16px;box-shadow:var(--shadow);display:flex;align-items:center;gap:14px}.metric-icon{width:48px;height:48px;border-radius:12px;display:grid;place-items:center;color:white;font-size:20px;flex:0 0 auto}.metric-icon.purple{background:linear-gradient(135deg,#7653ff,#5032df)}.metric-icon.blue{background:linear-gradient(135deg,#35a8ff,#2166dd)}.metric-icon.green{background:linear-gradient(135deg,#3bd47d,#0aa957)}.metric-icon.amber{background:linear-gradient(135deg,#ffc63d,#f09b00)}.metric-card small{color:var(--muted);font-size:10px;font-weight:650}.metric-card strong{display:block;font-size:24px;line-height:1.2;margin:2px 0}.metric-card em{font-style:normal;color:#12a765;font-size:10px;font-weight:700}.dashboard-grid{display:grid;grid-template-columns:1.25fr .9fr;gap:16px;margin-bottom:16px}.panel{background:#fff;border:1px solid var(--line);border-radius:13px;box-shadow:var(--shadow);padding:16px;min-width:0}.panel-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}.panel-head h2{font-size:14px;margin:0}.panel-head a,.panel-head button{color:var(--primary);font-size:10px;font-weight:700;border:0;background:transparent}.chart-wrap{height:240px}.activity-list{display:grid}.activity-item{display:flex;gap:10px;padding:10px 0;border-bottom:1px solid #eef1f6}.activity-item:last-child{border:0}.activity-dot{width:24px;height:24px;border-radius:50%;display:grid;place-items:center;background:#edf0ff;color:#5b46f5;font-size:10px;flex:none}.activity-item strong{font-size:11px;display:block}.activity-item small{font-size:9px;color:var(--muted)}.three-grid{display:grid;grid-template-columns:1fr 1fr .8fr;gap:16px}.mini-list{display:grid;gap:11px}.mini-row{display:grid;grid-template-columns:1fr 70px 35px;gap:8px;align-items:center;font-size:10px}.mini-progress{height:5px;background:#e8ebf2;border-radius:9px;overflow:hidden}.mini-progress span{height:100%;display:block;background:linear-gradient(90deg,#5c43ef,#6c5ff5)}.status-row{display:flex;justify-content:space-between;font-size:10px;padding:8px 0;border-bottom:1px solid #eff2f6}.status-dot{width:7px;height:7px;background:#13b96a;border-radius:50%;display:inline-block;margin-right:5px}
.course-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.course-card{background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);overflow:hidden}.course-cover{height:105px;background:linear-gradient(135deg,#0e2b58,#4e42e9);display:flex;align-items:center;justify-content:center;color:white;font-size:36px;position:relative}.course-code{position:absolute;left:12px;top:10px;padding:4px 8px;background:rgba(255,255,255,.15);backdrop-filter:blur(5px);border-radius:6px;font-size:9px;font-weight:800}.course-body{padding:15px}.course-body h3{font-size:14px;margin:0 0 5px}.course-body p{font-size:10px;color:var(--muted);margin:0 0 10px}.progress{height:6px;background:#e8ebf2;border-radius:99px;overflow:hidden}.progress span{display:block;height:100%;background:linear-gradient(90deg,#5a44ef,#3f83ec)}.course-actions{display:flex;gap:7px;margin-top:12px;flex-wrap:wrap}
.btn,.primary-btn,.secondary-btn,.danger-btn,.action-btn,button[type=submit],a.button{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:0;border-radius:8px;padding:9px 12px;font-size:11px;font-weight:750;transition:.18s}.btn-primary,.primary-btn,button[type=submit],a.button{color:#fff;background:linear-gradient(100deg,#5c43ef,#344ee8);box-shadow:0 7px 16px rgba(82,63,235,.18)}.secondary-btn{background:#f1f4f9;color:#33415c;border:1px solid #dfe5ee}.danger-btn,.action-btn.delete{background:#e63850;color:#fff}.btn:hover,.primary-btn:hover,.secondary-btn:hover,.danger-btn:hover,.action-btn:hover,button:hover{transform:translateY(-1px)}
.data-card,.form-card,.card{background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:18px}.table-wrap{overflow:auto}table{width:100%;border-collapse:separate;border-spacing:0;min-width:900px;background:#fff}th{padding:11px 12px;background:#f1f3ff;color:#343277;text-transform:uppercase;font-size:9px;letter-spacing:.04em;text-align:left}td{padding:11px 12px;border-bottom:1px solid #edf0f5;font-size:11px;vertical-align:middle}tbody tr:hover{background:#fafbff}.row-actions{display:flex;gap:6px;flex-wrap:wrap}.action-btn{color:#fff!important;padding:7px 9px}.action-btn.edit{background:#2d9bd6}.action-btn.enroll{background:#14b89b}.action-btn.reset{background:#f2a10b}.person-cell{display:flex;align-items:center;gap:9px}.avatar{width:34px;height:34px;border-radius:9px;background:linear-gradient(135deg,#6b54f2,#2d94e3);display:grid;place-items:center;color:#fff;font-weight:800}.status-pill,.badge{display:inline-flex;padding:4px 8px;border-radius:99px;font-size:9px;font-weight:750}.status-pill.active,.badge-success{background:#dcf8eb;color:#078055}.status-pill.inactive,.badge-danger{background:#ffe3e7;color:#a8273a}.badge-warning{background:#fff0ca;color:#895f00}
.form-card{max-width:940px;margin:auto}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.field{display:flex;flex-direction:column;gap:6px}.field.full{grid-column:1/-1}.field label,.form-card label{font-size:11px;font-weight:700}.field input,.field select,.field textarea,.form-card input,.form-card select,.form-card textarea,input,select,textarea{width:100%;min-height:42px;border:1px solid #dce2eb;border-radius:8px;background:#fbfcfe;padding:9px 11px;font-size:11px}.field input:focus,.field select:focus,.field textarea:focus,input:focus,select:focus,textarea:focus{outline:none;border-color:#6650ef;box-shadow:0 0 0 3px rgba(92,67,239,.1);background:#fff}.form-actions{grid-column:1/-1;display:flex;justify-content:flex-end;gap:9px;margin-top:8px}.empty-state{text-align:center;padding:34px;color:var(--muted);background:#fff;border:1px dashed #cfd7e5;border-radius:13px}
.auth-page{min-height:100vh;display:grid;grid-template-columns:minmax(300px,44%) minmax(380px,56%);background:#fff}.auth-visual{background:linear-gradient(145deg,#071a36,#102a59);color:#fff;position:relative;display:flex;flex-direction:column;justify-content:space-between;padding:38px;overflow:hidden}.auth-visual:before,.auth-visual:after{content:"";position:absolute;border-radius:50%;filter:blur(2px)}.auth-visual:before{width:300px;height:300px;background:rgba(91,70,245,.24);right:-100px;top:80px}.auth-visual:after{width:240px;height:240px;background:rgba(38,183,232,.14);left:-90px;bottom:40px}.auth-brand{position:relative;z-index:2;display:flex;align-items:center;gap:12px}.auth-brand img{width:54px}.auth-brand strong{font-size:21px}.auth-brand b{color:#8d7bff}.auth-copy{position:relative;z-index:2;max-width:420px}.auth-copy h2{font-size:34px;margin:0 0 10px}.auth-copy p{color:#bdc9dc;font-size:13px}.auth-illustration{position:relative;z-index:2;text-align:center;padding:20px}.auth-illustration i{font-size:120px;color:#7764ff;filter:drop-shadow(0 15px 20px rgba(0,0,0,.2))}.auth-footer{position:relative;z-index:2;color:#8fa0b9;font-size:10px}.auth-form-side{display:grid;place-items:center;padding:35px}.auth-card{width:min(410px,100%)}.auth-card h1{font-size:26px;color:#4e3ce2;margin:0 0 4px}.auth-card>p{font-size:11px;color:var(--muted);margin:0 0 25px}.auth-card label{font-size:10px;font-weight:650}.input-icon{position:relative;margin:7px 0 15px}.input-icon>i{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#8d99ac}.input-icon input{padding-left:36px}.password-toggle{position:absolute;right:8px;top:50%;transform:translateY(-50%);border:0;background:transparent;color:#77849a}.auth-submit{width:100%;height:42px;margin-top:6px}.auth-help{text-align:center;font-size:9px;color:var(--muted);margin-top:17px}
.certificate{max-width:1020px;margin:auto;background:#fff;padding:54px;border:9px solid transparent;border-image:linear-gradient(135deg,#d8a927,#f5dc83,#9d6b08) 1;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.13)}.certificate-logo{width:190px;margin:auto}.certificate h1{font-family:Georgia,serif;letter-spacing:.15em}.certificate h2{font-family:"Brush Script MT",cursive;font-size:50px;margin:20px 0}.cert-details{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.cert-footer{display:flex;justify-content:space-between;margin-top:45px}.print-actions{text-align:center;margin:20px}
.mobile-overlay{display:none}.desktop-only{display:block}@media(max-width:1050px){.stats-grid{grid-template-columns:repeat(2,1fr)}.three-grid{grid-template-columns:1fr 1fr}.three-grid>.panel:last-child{grid-column:1/-1}.course-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:820px){.app-layout{display:block}.sidebar{transform:translateX(-100%);transition:.2s}.sidebar.open{transform:none}.app-main{margin:0}.search-box{display:none}.content{padding:18px 14px}.dashboard-grid,.three-grid{grid-template-columns:1fr}.auth-page{grid-template-columns:1fr}.auth-visual{display:none}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.course-grid{grid-template-columns:1fr}.mobile-overlay.show{display:block;position:fixed;inset:0;background:rgba(2,10,24,.45);z-index:70}}@media(max-width:520px){.stats-grid{grid-template-columns:1fr}.top-header{padding:0 14px}.profile-chip .profile-copy{display:none}.page-title-row{align-items:flex-start;flex-direction:column}.cert-details{grid-template-columns:1fr}.certificate{padding:28px 15px}.certificate h2{font-size:34px}}
@media print{.sidebar,.top-header,.print-actions{display:none!important}.app-main{grid-column:1}.content{padding:0}.certificate{box-shadow:none}}

/* Learnova v6 completion styles */
.eyebrow{display:block;color:#6c55ef;font-size:10px;font-weight:800;letter-spacing:.13em;margin-bottom:7px}.table-toolbar{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:15px}.toolbar-title{display:flex;align-items:center;gap:11px}.toolbar-title>i{width:40px;height:40px;display:grid;place-items:center;border-radius:10px;background:#eeeaff;color:#5c43ef}.toolbar-title strong,.toolbar-title small{display:block}.toolbar-title small{color:var(--muted);font-size:10px}.table-search{max-width:280px!important}.password-cell{display:flex;align-items:center;gap:6px}.pw-value{font-family:monospace;min-width:54px}.course-chip{display:inline-flex;background:#e9edff;color:#4035a6;padding:4px 7px;border-radius:6px;font-size:9px;font-weight:750;margin:2px}.chip-list{display:flex;flex-wrap:wrap}.person-cell small,td small{display:block;color:var(--muted);font-size:9px;margin-top:2px}.inline-form,.row-actions form{display:inline;margin:0}.profile-menu{position:relative}.profile-chip{border:0;background:transparent;cursor:pointer}.profile-dropdown{display:none;position:absolute;right:0;top:48px;background:#fff;border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow);padding:7px;width:170px}.profile-dropdown.show{display:grid}.profile-dropdown a{padding:9px;border-radius:7px;font-size:11px}.profile-dropdown a:hover{background:#f3f1ff;color:#513be3}.profile-dropdown i{width:20px}.report-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-bottom:18px}.report-summary article{background:#fff;border:1px solid var(--line);border-radius:13px;box-shadow:var(--shadow);padding:18px;display:flex;align-items:center;gap:13px}.report-summary i{width:44px;height:44px;display:grid;place-items:center;border-radius:11px;background:#eeeaff;color:#5c43ef}.report-summary strong,.report-summary span{display:block}.report-summary span{font-size:10px;color:var(--muted)}.report-card{background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:18px;margin-bottom:16px}.report-teacher{display:flex;gap:12px;align-items:center;margin-bottom:14px}.report-teacher h2{margin:0;font-size:17px}.report-teacher p{margin:2px 0;color:var(--muted);font-size:10px}.course-report-head{display:flex;justify-content:space-between;align-items:center;background:#f6f7fc;border-radius:9px;padding:11px;margin:13px 0}.course-report-head>div{display:flex;align-items:center;gap:9px}.course-report-head a{color:#5841e8;font-size:10px;font-weight:700}.compact{padding:16px}.notification-center{display:grid;gap:10px}.notification-card{display:flex;gap:13px;background:#fff;border:1px solid var(--line);border-radius:12px;padding:15px;box-shadow:var(--shadow)}.notification-card.unread{border-left:4px solid #5c43ef;background:#fbfaff}.notification-symbol{width:38px;height:38px;border-radius:10px;background:#eeeaff;color:#5c43ef;display:grid;place-items:center;flex:none}.notification-card strong{font-size:12px}.notification-card p{margin:3px 0;color:var(--muted);font-size:10px}.notification-card small{font-size:9px;color:#8995aa}.message-grid{display:grid;gap:10px}.message-card{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px;box-shadow:var(--shadow)}.message-card p{margin:3px 0;font-size:10px;color:var(--muted)}.message-card small{font-size:9px;color:var(--muted)}.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.setting-row{display:flex;justify-content:space-between;align-items:center;padding:13px 0;border-bottom:1px solid var(--line)}.setting-row strong,.setting-row small{display:block}.setting-row strong{font-size:11px}.setting-row small{font-size:9px;color:var(--muted)}.help-hero{text-align:center;background:linear-gradient(135deg,#0a2144,#533ce7);color:#fff;padding:42px;border-radius:16px;box-shadow:var(--shadow);margin-bottom:18px}.help-hero .eyebrow{color:#bdb4ff}.help-hero h1{font-size:32px;margin:5px}.help-hero p{color:#c7d2e5}.help-search{max-width:580px;margin:20px auto 0;position:relative}.help-search i{position:absolute;left:15px;top:50%;transform:translateY(-50%);color:#8290a7}.help-search input{padding-left:42px;background:#fff}.help-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.help-grid article{background:#fff;border:1px solid var(--line);border-radius:13px;padding:20px;box-shadow:var(--shadow)}.help-grid article>i{font-size:23px;color:#5b46f5}.help-grid h3{font-size:14px}.help-grid p{font-size:10px;color:var(--muted)}
.forum-shell{min-height:100vh;display:grid;grid-template-columns:240px 1fr}.forum-sidebar{background:linear-gradient(180deg,#071a36,#06162d);color:#fff;padding:22px 14px}.forum-main{padding:30px;max-width:1300px;width:100%;margin:auto}.forum-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.forum-header h1{font-size:28px;margin:0}.forum-header p{font-size:11px;color:var(--muted)}.forum-filters{display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:10px;background:#fff;border:1px solid var(--line);padding:13px;border-radius:12px;box-shadow:var(--shadow);margin-bottom:16px}.forum-filters .input-icon{margin:0}.topic-list{display:grid;gap:10px}.topic-card{background:#fff;border:1px solid var(--line);border-radius:13px;box-shadow:var(--shadow);padding:16px;display:grid;grid-template-columns:55px 1fr;gap:14px}.topic-vote{border-right:1px solid var(--line);display:flex;flex-direction:column;align-items:center;justify-content:center;color:#6b7890}.topic-content h2{font-size:15px;margin:7px 0}.topic-content p{font-size:10px;color:var(--muted)}.topic-tags{display:flex;gap:5px}.topic-meta{display:flex;gap:16px;flex-wrap:wrap;color:#78869b;font-size:9px}.topic-meta i{margin-right:4px}.badge{background:#eeeaff;color:#4c3fc1}.forum-sidebar .sidebar-brand{margin-bottom:25px}.forum-sidebar .side-nav{margin-top:18px}
.course-workspace{display:grid;grid-template-columns:240px minmax(0,1fr);min-height:100vh}.workspace-side{background:#071a36;color:#fff;padding:22px 14px;position:sticky;top:0;height:100vh}.workspace-main{min-width:0}.workspace-content{padding:28px;max-width:1300px;margin:auto}.workspace-hero{background:linear-gradient(135deg,#0b2349,#5a42eb);color:#fff;border-radius:16px;padding:25px;display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;box-shadow:var(--shadow)}.workspace-hero h1{margin:5px 0}.workspace-hero p{color:#cad4e6}.workspace-section{background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:18px;margin-bottom:15px}.workspace-section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:13px}.workspace-section-head h2{font-size:15px;margin:0}.resource-card{border:1px solid var(--line);border-radius:10px;padding:13px;margin-bottom:9px;display:flex;justify-content:space-between;align-items:center;gap:12px}.resource-card h3{font-size:12px;margin:0 0 4px}.resource-card p,.resource-card small{font-size:9px;color:var(--muted);margin:0}.resource-actions{display:flex;gap:6px;flex-wrap:wrap}.logo-mark{width:42px;height:42px}
@media(max-width:900px){.settings-grid,.help-grid{grid-template-columns:1fr}.forum-shell,.course-workspace{display:block}.forum-sidebar,.workspace-side{position:relative;height:auto}.forum-filters{grid-template-columns:1fr}.report-summary{grid-template-columns:1fr}.table-toolbar{align-items:flex-start;flex-direction:column}.table-search{max-width:none!important}}

.form-intro{display:flex;align-items:center;gap:13px;padding-bottom:16px;margin-bottom:18px;border-bottom:1px solid var(--line)}.form-intro h2{margin:0;font-size:17px}.form-intro p{margin:3px 0 0;font-size:10px;color:var(--muted)}.form-icon{width:48px;height:48px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(135deg,#6c52f4,#2d83ed);color:#fff;font-size:20px}.field label span{color:#e73550}.form-card .input-icon{margin:0}.form-card .input-icon input{padding-left:36px}.form-card .password-toggle{min-height:auto;width:auto;padding:5px;background:transparent;box-shadow:none;color:#77849a}
